diff --git a/projectm-eval/CompileContext.c b/projectm-eval/CompileContext.c
index 57fa423..2ce7e4e 100644
--- a/projectm-eval/CompileContext.c
+++ b/projectm-eval/CompileContext.c
@@ -10,6 +10,48 @@
 #include <stdlib.h>
 #include <string.h>
 
+/* Local host extension. Evaluate each argument once, left to right, and copy
+ * its value before the next argument can change the same variable. */
+static void prjm_eval_host_function2_call(prjm_eval_exptreenode_t* expression, PRJM_EVAL_F** result)
+{
+    PRJM_EVAL_F first = 0, last = 0;
+    PRJM_EVAL_F* first_pointer = &first;
+    PRJM_EVAL_F* last_pointer = &last;
+    expression->args[0]->func(expression->args[0], &first_pointer);
+    first = *first_pointer;
+    expression->args[1]->func(expression->args[1], &last_pointer);
+    last = *last_pointer;
+    prjm_eval_function_def_t* function = expression->host_definition;
+    expression->value = function->host_function(function->host_user, first, last);
+    *result = &expression->value;
+}
+
+int projectm_eval_context_register_function2(struct projectm_eval_context* context, const char* name,
+                                            projectm_eval_host_function2 callback, void* user)
+{
+    if (!context || !name || !*name || !callback) return 0;
+    for (prjm_eval_function_list_item_t* item = context->functions.first; item; item = item->next)
+        if (_stricmp(item->function->name, name) == 0) return 0;
+    prjm_eval_function_list_item_t* entry = calloc(1, sizeof(*entry));
+    prjm_eval_function_def_t* function = calloc(1, sizeof(*function));
+    char* owned_name = _strdup(name);
+    if (!entry || !function || !owned_name)
+    {
+        free(owned_name); free(function); free(entry); return 0;
+    }
+    function->name = owned_name;
+    function->arg_count = 2;
+    function->func = prjm_eval_host_function2_call;
+    function->host_function = callback;
+    function->host_user = user;
+    // Host data changes between frames even when both arguments are literals.
+    function->is_const_eval = false;
+    entry->function = function;
+    entry->next = context->functions.first;
+    context->functions.first = entry;
+    return 1;
+}
+
 prjm_eval_compiler_context_t* prjm_eval_create_compile_context(projectm_eval_mem_buffer global_memory,
                                                                PRJM_EVAL_F (*global_variables)[100])
 {
